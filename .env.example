# App / runtime 
NODE_ENV= # development | staging | production

# Public App Metadata (logging context, support/debug, UI env indication)
NEXT_PUBLIC_APP_NAME=Platform Shell
NEXT_PUBLIC_APP_ENV= # local | staging | production

# API connectivity (primary API for server-driven-ui payloads)
NEXT_PUBLIC_API_BASE_URL=

# Set by CI at build time
NEXT_PUBLIC_GIT_SHA=unknown

# Auth — Supabase (public)
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Feature flags (add as we go)
NEXT_PUBLIC_FEATURE_SDUI=true
# ... add more

# Log level
NEXT_PUBLIC_LOG_LEVEL= # debug | info | warn | error

# Server-driven UI
NEXT_PUBLIC_SDUI_SCHEMA_VERSION=1
NEXT_PUBLIC_SDUI_STRICT_MODE=true

# Server only secrets
SUPABASE_SECRET_KEY=
AUTH_WEBHOOK_SECRET=

# Server-only Veritie (browser capture uses /api/veritie proxy — no public Veritie secrets)
VERITIE_API_URL=
VERITIE_PIPELINE_ALIAS=
VERITIE_API_KEY=
CAPTURES_PERSIST_SECRET=
ALLOW_STUB_CAPTURE_MUTATIONS=

# Optional: override direct browser Veritie URL (not used when capture goes via /api/veritie proxy)
# NEXT_PUBLIC_VERITIE_API_URL=
# NEXT_PUBLIC_VERITIE_PIPELINE_ALIAS=
# NEXT_PUBLIC_CAPTURE_LAUNCHER_ENABLED=true

# Optional: private bucket for saved voice log audio (account-scoped paths)
SUPABASE_AUDIO_BUCKET=audio

OPENAI_API_KEY=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Data source (stub | backend) — backend uses Drizzle when DATABASE_URL is set
PLATFORM_SHELL_FE_DATA_SOURCE=backend

# OpenAI (optional model override for /api/chat)
# OPENAI_MODEL=gpt-4o-mini

# Supabase secrets
SUPABASE_SECRET_KEY=
DATABASE_URL=